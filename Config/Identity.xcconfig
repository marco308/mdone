// Who the app is signed as, and under which identifiers (#154).
//
// These are mDone's own values, and they are what Release builds use, always:
// Release reads this file and nothing else, so an archive cannot pick up a
// contributor's local overrides. Debug reads Debug.xcconfig, which includes
// this file and then Config/Local.xcconfig if that exists.
//
// To build with your own Apple ID or Personal Team, do not edit this file.
// Copy Local.xcconfig.example to Local.xcconfig (it is gitignored) and change
// the values there. See "Building with your own Apple team" in
// docs/dev-setup.md.

// The start of every bundle ID. project.yml builds the rest from it:
// $(MDONE_BUNDLE_PREFIX).app for Release, .app.dev for Debug, .app.widgets and
// so on, and the App Group is "group." followed by the app's bundle ID.
MDONE_BUNDLE_PREFIX = com.mdone

DEVELOPMENT_TEAM = Z62E7MGREE

// The iOS app's entitlements. The default includes push notifications
// (aps-environment), which a Personal Team cannot sign. mDone-NoPush is the
// same file without it.
MDONE_IOS_ENTITLEMENTS = mDone/mDone.entitlements
